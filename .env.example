# Padrao local: runtime portatil automatico, sem chave de API.
LLM_PROVIDER=native
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-GGUF:Q4_K_M
LLM_REVISION=bb5d59e06d9551d752d08b292a50eb208b07ab1f
LLM_THREADS=4
LLM_TIMEOUT=180

# Alternativa com Ollama instalado e iniciado: ollama pull qwen2.5:3b
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
# LLM_REVISION=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Alternativa Python (mais lenta em CPU; requer trocar as tres variaveis):
# LLM_PROVIDER=transformers
# LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# LLM_REVISION=989aa7980e4cf806f80c7fef2b1adb7bc71aa306

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_THREADS=4
# Valores de partida, nao probabilidades nem limites universais.
MIN_SIMILARITY=0.75
MIN_EVIDENCES=2
TOP_K=8
RETRIEVAL_MODE=hybrid
