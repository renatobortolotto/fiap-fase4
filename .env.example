# Padrão sem serviço pago; instalar Ollama e executar: ollama pull qwen2.5:3b
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT=180

# Alternativa sem Ollama (baixa ~1 GB; qualidade limitada, CPU pode ser lenta):
# LLM_PROVIDER=transformers
# LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# LLM_REVISION=7ae557604adf67be50417f59c2c2f167def9a775

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# Valor inicial, precisa ser calibrado com perguntas rotuladas.
MIN_SIMILARITY=0.75
MIN_EVIDENCES=2
TOP_K=8
RETRIEVAL_MODE=hybrid
